{
  "name": "orkestrix",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r --workspace-concurrency=1 build",
    "preview": "corepack pnpm --filter @orkestrix/web preview",
    "typecheck": "corepack pnpm -r typecheck",
    "start": "corepack pnpm --filter @orkestrix/api start",
    "test": "corepack pnpm --filter @orkestrix/api build && corepack pnpm --filter @orkestrix/api test && corepack pnpm --filter @orkestrix/web test:e2e"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
