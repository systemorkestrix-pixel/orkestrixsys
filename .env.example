# ==============================================================================
# ORKESTRIX SYSTEMS — PRODUCTION ENVIRONMENT VARIABLES REFERENCE
# Stack: Vercel + Supabase PostgreSQL + Supabase Storage + orkestrix.site
# NEVER commit .env to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CREDENTIALS (Required in Production)
# Found in your Supabase Dashboard under Settings → API & Database
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (Server-side ONLY — NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase PostgreSQL Connection URI (Session Pooler or Direct Connection)
# Found in Supabase Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Storage Bucket Name (Default: project-media)
SUPABASE_STORAGE_BUCKET=project-media

# ------------------------------------------------------------------------------
# 2. BOOTSTRAP ADMIN (ONE-TIME INITIAL SETUP)
# Set these to automatically provision the initial admin user on first run.
# Remove them from production environment variables after first login.
# ------------------------------------------------------------------------------
ORKESTRIX_BOOTSTRAP_ADMIN_EMAIL=admin@orkestrix.site
ORKESTRIX_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secure-password-min-12-chars

# ------------------------------------------------------------------------------
# 3. CANONICAL DOMAIN & SECURITY
# ------------------------------------------------------------------------------
CANONICAL_DOMAIN=https://orkestrix.site
NODE_ENV=production
